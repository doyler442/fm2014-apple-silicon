+/* Track successful locks on this thread so an AppKit update dispatched to
+ * main can acquire the same context without waiting on its blocked caller. */
+typedef struct ContextLock { void *ctx; unsigned depth; } ContextLock;
+static __thread ContextLock context_locks[32];
+static ContextLock *context_lock(void *ctx, int create)
+{
+    ContextLock *empty = NULL;
+    for (unsigned i = 0; i < 32; i++) {
+        if (context_locks[i].ctx == ctx && ctx) return &context_locks[i];
+        if (!context_locks[i].depth && !empty) empty = &context_locks[i];
+    }
+    if (create && empty) { empty->ctx = ctx; return empty; }
+    return NULL;
+}
+int m32_cgl_lock(void *ctx)
+{
+    static int (*lock)(void *);
+    if (!lock) lock = ocerz_bridge_host_symbol(GL_LIB, "CGLLockContext");
+    int r = lock ? lock(ctx) : 10000;
+    if (!r && getenv("OCERZ_M32_GL_LOCK_HANDOFF")) {
+        ContextLock *entry = context_lock(ctx, 1);
+        if (entry) entry->depth++;
+    }
+    return r;
+}
+int m32_cgl_unlock(void *ctx)
+{
+    static int (*unlock)(void *);
+    if (!unlock) unlock = ocerz_bridge_host_symbol(GL_LIB, "CGLUnlockContext");
+    int r = unlock ? unlock(ctx) : 10000;
+    if (!r && getenv("OCERZ_M32_GL_LOCK_HANDOFF")) {
+        ContextLock *entry = context_lock(ctx, 0);
+        if (entry && entry->depth) entry->depth--;
+    }
+    return r;
+}
+unsigned m32_cgl_handoff_begin(void *ctx)
+{
+    ContextLock *entry = context_lock(ctx, 0);
+    unsigned depth = entry ? entry->depth : 0, released = 0;
+    while (released < depth && !m32_cgl_unlock(ctx)) released++;
+    if (released && getenv("OCERZ_M32LOG"))
+        fprintf(stderr, "ocerz: m32: handing %u graphics locks to main thread\n", released);
+    return released;
+}
+void m32_cgl_handoff_end(void *ctx, unsigned depth)
+{
+    for (unsigned i = 0; i < depth; i++)
+        if (m32_cgl_lock(ctx)) { fprintf(stderr, "ocerz: failed to restore graphics lock\n"); abort(); }
+}
+static int sp_CGLLockContext(struct OcerzVM *vm, OcerzCPU *cpu)
+{ (void)vm; RET(m32_cgl_lock(m32_host(m32_arg(cpu, 0)))); }
+static int sp_CGLUnlockContext(struct OcerzVM *vm, OcerzCPU *cpu)
+{ (void)vm; RET(m32_cgl_unlock(m32_host(m32_arg(cpu, 0)))); }
 
