+static void mark_main_work(void *p) { *(int *)p = 1; }
+static void test_timed_wait_pump(void)
+{
+    dlopen("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation", RTLD_NOW | RTLD_GLOBAL);
+    setenv("OCERZ_M32_MAIN_WAIT_PUMP", "1", 1);
+    uint32_t cond = DATA + 0xa00, mutex = DATA + 0xb00, ts = DATA + 0xc00;
+    uint32_t initc[] = { cond, 0 }, initm[] = { mutex, 0 }, lock[] = { mutex };
+    call("_pthread_cond_init", 2, initc); call("_pthread_mutex_init", 2, initm);
+    call("_pthread_mutex_lock", 1, lock);
+    uint32_t args[] = { cond, mutex, ts };
+    for (int relative = 0; relative < 2; relative++) {
+        struct timespec now; clock_gettime(CLOCK_REALTIME, &now);
+        m32_wr(ts, relative ? 1 : (uint32_t)now.tv_sec + 1);
+        m32_wr(ts + 4, relative ? 0 : (uint32_t)now.tv_nsec);
+        int ran = 0;
+        dispatch_async_f(dispatch_get_main_queue(), &ran, mark_main_work);
+        uint64_t start = clock_gettime_nsec_np(CLOCK_MONOTONIC);
+        check("timed main wait permits spurious wake", call(relative ? "_pthread_cond_timedwait_relative_np" :
+              "_pthread_cond_timedwait", 3, args) == 0);
+        check("timed main wait services queued main work", ran == 1);
+        check("timed main wait returns before long deadline", clock_gettime_nsec_np(CLOCK_MONOTONIC) - start < 500000000);
+        m32_wr(ts, 0); m32_wr(ts + 4, 0);
+        check("actual expired deadline returns timeout", call(relative ? "_pthread_cond_timedwait_relative_np" :
+              "_pthread_cond_timedwait", 3, args) == ETIMEDOUT);
+    }
+    check("mutex remains held after waits", call("_pthread_mutex_unlock", 1, lock) == 0);
+    call("_pthread_cond_destroy", 1, initc); call("_pthread_mutex_destroy", 1, initm);
+}
