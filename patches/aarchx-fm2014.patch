+/* Old hybrid Carbon/Cocoa games install timers on the main run loop, but
+ * need Cocoa to dispatch their window's mouse and keyboard events. Opt in
+ * to NSApplication's event loop while retaining the installed run-loop timers. */
+static int application_loop(OcerzCPU *cpu, int stop)
+{
+    if (getenv("OCERZ_M32_COCOA_EVENT_LOOP")) {
+        void *(*cls)(const char *) = dlsym(RTLD_DEFAULT, "objc_getClass");
+        void *(*sel)(const char *) = dlsym(RTLD_DEFAULT, "sel_registerName");
+        void *(*send)(void *, void *) = dlsym(RTLD_DEFAULT, "objc_msgSend");
+        void *app = cls && sel && send ? send(cls("NSApplication"), sel("sharedApplication")) : NULL;
+        if (app) {
+            fprintf(stderr, "ocerz: m32: %s Cocoa application event loop\n", stop ? "stopping" : "starting");
+            if (stop)
+                ((void (*)(void *, void *, void *))send)(app, sel("stop:"), NULL);
+            else
+                ((void (*)(void *, void *))send)(app, sel("run"));
+            m32_ret(cpu, 0, 0, 0);
+            return OCERZ_STEP_OK;
+        }
+    }
+    void *lib = dlopen("/System/Library/Frameworks/Carbon.framework/Frameworks/HIToolbox.framework/HIToolbox", RTLD_LAZY);
+    void (*native)(void) = lib ? dlsym(lib, stop ? "QuitApplicationEventLoop" : "RunApplicationEventLoop") : NULL;
+    if (native) native();
+    m32_ret(cpu, 0, 0, 0);
+    return OCERZ_STEP_OK;
+}
