+static void test_gl_lock_handoff(void)
+{
+    void *lib = dlopen("/System/Library/Frameworks/OpenGL.framework/OpenGL", RTLD_LAZY | RTLD_GLOBAL);
+    check("OpenGL loads", lib != NULL);
+    if (!lib) return;
+    int (*choose)(const int *, void **, int *) = dlsym(lib, "CGLChoosePixelFormat");
+    int (*create)(void *, void *, void **) = dlsym(lib, "CGLCreateContext");
+    int (*destroy)(void *) = dlsym(lib, "CGLDestroyContext");
+    int (*destroy_pf)(void *) = dlsym(lib, "CGLDestroyPixelFormat");
+    g_test_cgl_lock = dlsym(lib, "CGLLockContext"); g_test_cgl_unlock = dlsym(lib, "CGLUnlockContext");
+    void *pf = NULL, *ctx = NULL; int count = 0, attrs[] = { 0 };
+    check("choose pixel format", choose && choose(attrs, &pf, &count) == 0 && pf);
+    check("create graphics context", pf && create && create(pf, NULL, &ctx) == 0 && ctx);
+    if (!ctx) { if (pf) destroy_pf(pf); return; }
+    setenv("OCERZ_M32_GL_LOCK_HANDOFF", "1", 1);
+    check("take recursive graphics locks", !m32_cgl_lock(ctx) && !m32_cgl_lock(ctx));
+    unsigned depth = m32_cgl_handoff_begin(ctx);
+    check("release both lock levels", depth == 2);
+    pthread_t t; void *result = (void *)1;
+    int started = pthread_create(&t, NULL, test_lock_handoff_worker, ctx);
+    check("start recipient thread", started == 0);
+    if (!started) pthread_join(t, &result);
+    check("recipient acquired and released context", !started && result == NULL);
+    m32_cgl_handoff_end(ctx, depth);
+    check("restore both lock levels", m32_cgl_handoff_begin(ctx) == 2);
+    m32_cgl_handoff_end(ctx, 2);
+    check("original owner can unlock twice", !m32_cgl_unlock(ctx) && !m32_cgl_unlock(ctx));
+    check("unheld context has no handoff", m32_cgl_handoff_begin(ctx) == 0);
+    destroy(ctx); destroy_pf(pf);
+}
