+static void test_clock_units(void)
+{
+    const int32_t durations[] = { 0, 1, 1000, -1, -1000, INT32_MIN, INT32_MAX };
+    for (unsigned i = 0; i < sizeof durations / sizeof *durations; i++) {
+        int64_t d = durations[i];
+        uint64_t want = d < 0 ? (uint64_t)-d * 1000 : (uint64_t)d * 1000000;
+        uint32_t arg[] = { (uint32_t)d };
+        uint32_t lo = call("_DurationToAbsolute", 1, arg);
+        uint64_t got = lo | (uint64_t)(uint32_t)cpu()->gpr[OCERZ_RDX] << 32;
+        check("DurationToAbsolute uses virtual nanosecond ticks", got == want);
+        uint32_t absolute[] = { lo, (uint32_t)(got >> 32) };
+        uint32_t nslo = call("_AbsoluteToNanoseconds", 2, absolute);
+        check("absolute and nanosecond conversions agree", (nslo | (uint64_t)(uint32_t)cpu()->gpr[OCERZ_RDX] << 32) == want);
+    }
+    uint32_t args[] = { DATA + 0x800 };
+    call("_mach_timebase_info", 1, args);
+    check("virtual mach clock has a 1:1 timebase", m32_rd(DATA + 0x800) == 1 && m32_rd(DATA + 0x804) == 1);
+}
