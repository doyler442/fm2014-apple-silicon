+static void test_named_semaphore(void)
+{
+    char *name = m32_h(DATA + 0xd00);
+    snprintf(name, 80, "/ocerz_m32_%d", getpid());
+    sem_unlink(name);
+    uint32_t args[] = { DATA + 0xd00, O_CREAT | O_EXCL, 0600, 2 };
+    uint32_t handle = call("_sem_open", 4, args);
+    check("named semaphore creation returns a host handle", handle && handle != UINT32_MAX && m32_is_handle(handle));
+    if (!handle || handle == UINT32_MAX) return;
+    sem_t *sem = m32_host(handle);
+    check("creation initial count survives variadic bridge", sem_trywait(sem) == 0 && sem_trywait(sem) == 0);
+    check("semaphore is empty after initial count is consumed", sem_trywait(sem) == -1 && errno == EAGAIN);
+    args[1] = 0;
+    uint32_t second = call("_sem_open", 2, args);
+    check("opening existing semaphore needs no optional arguments", second != UINT32_MAX && second && m32_is_handle(second));
+    check("reopened handles share semaphore events", second && second != UINT32_MAX &&
+          sem_post(m32_host(second)) == 0 && sem_trywait(sem) == 0);
+    uint32_t semarg[] = { handle };
+    check("guest sem_post crossing wakes guest sem_trywait", cross("/usr/lib/libSystem.B.dylib", "_sem_post", 1, semarg) == 0 &&
+          cross("/usr/lib/libSystem.B.dylib", "_sem_trywait", 1, semarg) == 0);
+    check("guest trywait crossing reports empty", cross("/usr/lib/libSystem.B.dylib", "_sem_trywait", 1, semarg) == UINT32_MAX);
+    uint32_t duplicate[] = { DATA + 0xd00, O_CREAT | O_EXCL, 0600, 0 };
+    check("failed sem_open returns i386 SEM_FAILED", call("_sem_open", 4, duplicate) == UINT32_MAX);
+    uint32_t err = call("___error", 0, NULL);
+    check("failed sem_open preserves guest errno", m32_rd(err) == EEXIST);
+    if (second && second != UINT32_MAX) sem_close(m32_host(second));
+    sem_close(sem);
+    check("remove test semaphore", sem_unlink(name) == 0);
+    check("missing semaphore reports failure without create", call("_sem_open", 2, args) == UINT32_MAX);
+}
